---
interface Props {
  label: string;
  name: string;
  type?: "text" | "email" | "textarea" | "select";
  required?: boolean;
  placeholder?: string;
  helperText?: string;
  maxLength?: number;
  minLength?: number;
  options?: { value: string; label: string }[];
  value?: string;
  class?: string;
}

const {
  label,
  name,
  type = "text",
  required = false,
  placeholder,
  helperText,
  maxLength,
  minLength,
  options = [],
  value = "",
  class: className = ""
} = Astro.props;

const fieldId = `field-${name}`;
const helperId = helperText ? `${fieldId}-helper` : undefined;
const errorId = `${fieldId}-error`;
---

<div class={`form-field-group ${className}`}>
  <div class="label-row">
    <label for={fieldId} class="field-label">
      {label}
      {required && <span class="required-indicator" aria-hidden="true"> *</span>}
      {!required && <span class="optional-indicator"> (Optional)</span>}
    </label>
    {maxLength && (
      <span class="char-count" id={`${fieldId}-char-count`} aria-live="polite"></span>
    )}
  </div>

  {helperText && (
    <p id={helperId} class="field-helper">
      {helperText}
    </p>
  )}

  <div class="input-wrapper">
    {type === "textarea" ? (
      <textarea
        id={fieldId}
        name={name}
        required={required}
        placeholder={placeholder}
        maxlength={maxLength}
        minlength={minLength}
        rows={5}
        aria-describedby={[helperId, errorId].filter(Boolean).join(" ")}
        class="form-control form-textarea"
      >{value}</textarea>
    ) : type === "select" ? (
      <select
        id={fieldId}
        name={name}
        required={required}
        aria-describedby={[helperId, errorId].filter(Boolean).join(" ")}
        class="form-control form-select"
      >
        <option value="" disabled selected={!value}>Choose what you need help with...</option>
        {options.map((opt) => (
          <option value={opt.value} selected={opt.value === value}>
            {opt.label}
          </option>
        ))}
      </select>
    ) : (
      <input
        type={type}
        id={fieldId}
        name={name}
        value={value}
        required={required}
        placeholder={placeholder}
        maxlength={maxLength}
        minlength={minLength}
        aria-describedby={[helperId, errorId].filter(Boolean).join(" ")}
        class="form-control"
      />
    )}
  </div>

  <p id={errorId} class="field-error" style="display: none;" role="alert"></p>
</div>

<style>
  .form-field-group {
    margin-bottom: var(--space-6);
  }

  .label-row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-bottom: var(--space-2);
  }

  .field-label {
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--ink-950);
  }

  .required-indicator {
    color: var(--error);
  }

  .optional-indicator {
    font-size: 0.8125rem;
    font-weight: 400;
    color: var(--slate-500);
  }

  .char-count {
    font-size: 0.75rem;
    color: var(--slate-500);
    font-family: var(--font-mono);
  }

  .field-helper {
    font-size: 0.8125rem;
    color: var(--slate-500);
    margin-top: -2px;
    margin-bottom: var(--space-2);
    line-height: 1.4;
  }

  .form-control {
    width: 100%;
    min-height: 48px;
    padding: var(--space-3) var(--space-4);
    font-size: 1rem;
    border: 1px solid var(--slate-300);
    border-radius: var(--radius-md);
    background-color: var(--surface);
    color: var(--ink-950);
    transition: border-color var(--motion-fast) var(--ease-standard),
                box-shadow var(--motion-fast) var(--ease-standard);
  }

  .form-control:focus {
    border-color: var(--signal-blue);
    outline: 2px solid var(--signal-blue);
    outline-offset: 2px;
  }

  .form-control[aria-invalid="true"] {
    border-color: var(--error);
    background-color: #FFF9F9;
  }

  .form-textarea {
    resize: vertical;
    min-height: 120px;
    line-height: 1.5;
  }

  .form-select {
    cursor: pointer;
    background-color: var(--surface);
  }

  .field-error {
    margin-top: var(--space-2);
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--error);
  }
</style>
