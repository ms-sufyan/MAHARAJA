---
interface Props {
  summary: string;
  variant?: "light" | "dark";
  id?: string;
  class?: string;
  open?: boolean;
}

const {
  summary,
  variant = "light",
  id,
  class: className = "",
  open = false
} = Astro.props;
---

<details id={id} class={`custom-details ${variant === "dark" ? "custom-details-dark" : ""} ${className}`} open={open}>
  <summary>
    <span>{summary}</span>
  </summary>
  <div class="details-body">
    <slot />
  </div>
</details>
