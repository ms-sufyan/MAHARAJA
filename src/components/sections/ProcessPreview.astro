---
import SectionEyebrow from "../ui/SectionEyebrow.astro";
import TextLink from "../ui/TextLink.astro";

const stages = [
  { num: "01", name: "Understand", summary: "Identify the current inputs, people, and recurring manual friction points." },
  { num: "02", name: "Map", summary: "Make handoffs, business rules, field flows, and exceptions visible." },
  { num: "03", name: "Design", summary: "Determine system of record, integration paths, and manual human checkpoints." },
  { num: "04", name: "Build", summary: "Implement minimal reliable system with robust triggers and fail-safe logic." },
  { num: "05", name: "Validate", summary: "Test happy path, edge cases, missing data, and third-party error recovery." },
  { num: "06", name: "Handover", summary: "Deliver architectural documentation, operational training, and run history." }
];
---

<section class="process-preview-section section-py" aria-labelledby="process-preview-heading">
  <div class="container-default">
    <div class="process-header">
      <SectionEyebrow>HOW WE WORK</SectionEyebrow>
      <h2 id="process-preview-heading" class="section-title">
        Understand first. Automate second.
      </h2>
      <p class="body-large process-lead">
        The process begins with what happens today—not with a predetermined software recommendation.
      </p>
    </div>

    <!-- 6-Stage Timeline -->
    <div class="process-timeline">
      {stages.map((stage) => (
        <div class="timeline-step">
          <div class="timeline-marker">
            <span class="timeline-seq">{stage.num}</span>
            <span class="timeline-line" aria-hidden="true"></span>
          </div>
          <h3 class="timeline-title">{stage.name}</h3>
          <p class="timeline-summary">{stage.summary}</p>
        </div>
      ))}
    </div>

    <div class="process-footer">
      <TextLink href="/how-we-work">
        See the implementation process
      </TextLink>
    </div>
  </div>
</section>

<style>
  .process-preview-section {
    background-color: var(--canvas-alt);
    border-top: 1px solid var(--slate-200);
    border-bottom: 1px solid var(--slate-200);
  }

  .process-header {
    max-width: 720px;
    margin-bottom: var(--space-16);
  }

  .process-header h2 {
    margin-top: var(--space-2);
    margin-bottom: var(--space-4);
  }

  .process-timeline {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: var(--space-6);
    margin-bottom: var(--space-12);
  }

  @media (max-width: 1024px) {
    .process-timeline {
      grid-template-columns: repeat(3, 1fr);
      gap: var(--space-8);
    }
  }

  @media (max-width: 640px) {
    .process-timeline {
      grid-template-columns: 1fr;
      gap: var(--space-6);
    }
  }

  .timeline-step {
    display: flex;
    flex-direction: column;
  }

  .timeline-marker {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    margin-bottom: var(--space-4);
  }

  .timeline-seq {
    font-size: 0.8125rem;
    font-weight: 700;
    font-family: var(--font-mono);
    color: var(--signal-blue);
    background-color: var(--signal-blue-soft);
    padding: 2px 8px;
    border-radius: var(--radius-full);
  }

  .timeline-line {
    flex: 1;
    height: 1px;
    background-color: var(--slate-200);
  }

  @media (max-width: 640px) {
    .timeline-line {
      display: none;
    }
  }

  .timeline-title {
    font-size: 1.125rem;
    font-weight: 700;
    color: var(--ink-950);
    margin-bottom: var(--space-2);
  }

  .timeline-summary {
    font-size: 0.875rem;
    color: var(--slate-600);
    line-height: 1.55;
  }

  .process-footer {
    display: flex;
    justify-content: flex-start;
  }
</style>
