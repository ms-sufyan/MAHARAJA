# Cloudflare Workers / Turnstile / Rate Limiting Secrets
# Copy this file to .dev.vars for local testing. NEVER commit .dev.vars to source control.

# Turnstile Keys
# For local testing, use Cloudflare's official always-passing test keys:
# Sitekey: 1x00000000000000000000AA
# Secret: 1x0000000000000000000000000000000AA
PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
TURNSTILE_EXPECTED_HOSTNAME=localhost

# Rate Limiter HMAC Secret
# Generate a high-entropy random string (e.g. openssl rand -hex 32)
RATE_LIMIT_SECRET=dev_hmac_secret_for_local_development_only_replace_in_prod

# Domain and Security
CANONICAL_ORIGIN=http://localhost:4321

# Data Retention (Days) - must be evaluated by business/legal
DATA_RETENTION_DAYS=90

# Optional Web Analytics (true/false)
ENABLE_WEB_ANALYTICS=false

# Optional Outbound Email Notification Configuration
# NOTIFICATION_EMAIL=operations@example.com
# EMAIL_PROVIDER_API_KEY=optional_provider_key
# EMAIL_FROM_ADDRESS=notifications@example.com
